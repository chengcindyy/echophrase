# Azure Speech (Lambda / local API)
AZURE_SPEECH_KEY=
AZURE_SPEECH_REGION=eastus

# Neon Postgres (API/Lambda only — never expose to frontend)
DATABASE_URL=

# Google OAuth — backend verifies ID tokens
GOOGLE_CLIENT_ID=

# Web (Vite build)
# Local dev:
VITE_API_BASE_URL=http://localhost:3001
# Production deploy: leave empty (CloudFront proxies /api/*)

# Google OAuth — frontend Sign-In button (same value as GOOGLE_CLIENT_ID)
VITE_GOOGLE_CLIENT_ID=